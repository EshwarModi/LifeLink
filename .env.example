# ===================================================================
# LifeLink Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with strong secrets:
#   cp .env.example .env
#
# NOTE: If a password contains "$" or other shell-special characters,
# wrap the value in single quotes in .env, for example:
#   DB_PASSWORD='my$pass'
# ===================================================================

# MySQL Container Root Secret
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# Application & MySQL App-User Database Credentials
# (The mysql service in docker-compose.yml automatically derives its
# database name, user, and password from DB_NAME, DB_USER, and DB_PASSWORD)
DB_NAME=lifelink
DB_USER=lifelink
DB_PASSWORD=replace_with_strong_db_password

# Seeded Administrator Credentials
# ADMIN_PASSWORD must be >= 8 chars with at least 1 uppercase, 1 lowercase, and 1 digit
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lifelink.org
ADMIN_PASSWORD=ReplaceWithStrongPass1
