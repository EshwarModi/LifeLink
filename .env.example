# ===================================================================
# LifeLink Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with strong secrets:
#   cp .env.example .env
# ===================================================================

# MySQL Container Secrets
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
MYSQL_PASSWORD=replace_with_strong_mysql_user_password

# Application Database Credentials (must match MYSQL_USER and MYSQL_PASSWORD)
DB_NAME=lifelink
DB_USER=lifelink
DB_PASSWORD=replace_with_strong_mysql_user_password

# Seeded Administrator Credentials
# ADMIN_PASSWORD must be >= 8 chars with at least 1 uppercase, 1 lowercase, and 1 digit
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lifelink.org
ADMIN_PASSWORD=ReplaceWithStrongPass1
